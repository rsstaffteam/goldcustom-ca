  merchantWidgetScript.addEventListener('load', function () {
    merchantwidget.start({
         // REQUIRED FIELDS
         merchant_id: 5779961844,

         // OPTIONAL FIELDS (applies to desktop and mobile)
         position: 'LEFT_BOTTOM'
    });
  });
</script>


</head>

