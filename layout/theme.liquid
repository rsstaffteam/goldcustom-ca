{%- capture LS_INPUT -%}<!doctype html>
 


<html class="no-js" lang="{{ request.locale.iso_code }}">
   <head>


 {%- render 'ecom_header' -%}

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5">
    <meta name="theme-color" content="{{ settings.accent_color }}">

{%- if request.path == '/checkouts' -%}
  <meta name="robots" content="noindex">
{%- endif -%}
{%- if request.path == '/collections/all/anniversary+ring' -%}
  <meta name="robots" content="noindex">
{%- endif -%}

  
   <meta name="google-site-verification" content="vg5e9uSuMSNw_J5mxfTMHPXMTvLrqq2SaEy_sIRU8VI" />

   
    
 {% comment %} {% if page_description %}
	<meta name="description" content="{{ page_description | escape }}" />
{% endif %} {% endcomment %}
  {% comment %}
 <!-- SEO-BOOSTER-AUTO-DESCRIPTION --> 
 <meta name='description' content= '{% if template contains 'product' %}{{ product.description | truncate: 200| strip_html | strip_newlines | escape }}{% endif %}{% if template contains 'page' %}{{ page.content | truncate: 200 | strip_html | strip_newlines | escape }}{% endif %}' /> 
 {% endcomment %}    
    {%- capture seo_page_title -%}
      {%- if request.page_type == 'search' and search.terms != blank -%}
        {{ search.terms | replace: '*', '' | split: ' AND ' | last }} - {{ shop.name }}
      {%- else -%}
        {{ page_title }}{% if current_tags %}{% comment ls-rpl %}{% assign meta_tags = current_tags | join: ', ' %}{% endcomment %}{%- capture LS_TAGS -%}{%- render "ls-tags", resource: nil, tags: current_tags -%}{%- endcapture -%}{%- assign LS_TAGS = LS_TAGS | split: "," -%}{% assign meta_tags = LS_TAGS | join: ', ' %}{% comment /ls-rpl %}{% endcomment %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}
      {%- endif -%}
    {%- endcapture -%}

    <title>{{- seo_page_title -}}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | img_url: '96x96' }}" type="image/png">		
    {%- endif -%}
    
    {%- comment -%}Few prefech to increase performance on commonly used third-parties
    {%- endcomment -%}

    <link rel="preconnect" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com">
    <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">
    <link rel="dns-prefetch" href="https://ajax.googleapis.com">
    <link rel="dns-prefetch" href="https://maps.googleapis.com">
    <link rel="dns-prefetch" href="https://maps.gstatic.com">

    {% render 'css-variables' %}

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {% render 'social-meta-tags' %}

    {% render 'microdata-schema' %}

    <script>
      // This allows to expose several variables to the global scope, to be used in scripts
      window.theme = {
        pageType: {{ request.page_type | json }},
        cartCount: {{ cart.item_count | json }},
        moneyFormat: {{ shop.money_format | json }},
        moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
        showDiscount: {% if settings.show_discount %}true{% else %}false{% endif %},
        discountMode: {{ settings.discount_mode | json }},
        searchMode: {{ settings.search_mode | json }},
        cartType: {{ settings.cart_type | json }}
      };

      window.routes = {
        rootUrl: {{ routes.root_url | json }},
        cartUrl: {{ routes.cart_url | json }},
        cartAddUrl: {{ routes.cart_add_url | json }},
        cartChangeUrl: {{ routes.cart_change_url | json }},
        searchUrl: {{ routes.search_url | json }},
        productRecommendationsUrl: {{ routes.product_recommendations_url | json }}
      };

      window.languages = {
        collectionOnSaleLabel: {{ 'collection.product.discount_html' | t | json }},
        productFormUnavailable: {{ 'product.form.unavailable' | t | json }},
        productFormAddToCart: {% if product.template_suffix == 'pre-order' %}{{ 'product.form.pre_order' | t | json }}{% else %}{{ 'product.form.add_to_cart' | t | json }}{% endif %},
        productFormSoldOut: {{ 'product.form.sold_out' | t | json }},
        shippingEstimatorNoResults: {{ 'cart.shipping_estimator.no_results_title' | t | json }},
        shippingEstimatorOneResult: {{ 'cart.shipping_estimator.one_result_title' | t | json }},
        shippingEstimatorMultipleResults: {{ 'cart.shipping_estimator.multiple_results_title' | t | json }},
        shippingEstimatorErrors: {{ 'cart.shipping_estimator.errors' | t | json }}
      };

      window.lazySizesConfig = {
        loadHidden: false,
        hFac: 0.8,
        expFactor: 3,
        customMedia: {
          '--phone': '(max-width: 640px)',
          '--tablet': '(min-width: 641px) and (max-width: 1023px)',
          '--lap': '(min-width: 1024px)'
        }
      };

      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>

    {%- if request.page_type == 'customers/addresses' -%}
      <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
      <script src="{{ 'customer_area.js' | shopify_asset_url }}" defer></script>
    {%- endif -%}

    <script src="{{ 'theme.min.js' | asset_url }}" defer></script>
    <script src="{{ 'custom.js' | asset_url }}" defer></script>

    {%- comment -%}
      Removed Warehouse's onpageshow cart:refresh: it was a SyntaxError here and never ran on the live store. Running it re-renders
      the cart section on every load (wipes the Partial.ly / Sezzle buttons on /cart) and throws with cart_type "page" (no mini-cart).
    {%- endcomment -%}

<script>
window.mlvedaShopCurrency = "{{ shop.currency }}";
window.shopCurrency = "{{ shop.currency }}";
window.supported_currencies = "{{ settings.mlvedaACS_supportedCurrencies }}";
</script>

    {%- comment -%}GA4 (G-JFWZPXSCQL) and Meta Pixel load through Shopify's Google & YouTube and Facebook & Instagram channel pixels in content_for_header. Do not hard-code gtag here, it double-counts page views.{%- endcomment -%}

    {% if template contains 'collection' %}<script src="{{ 'ajaxinate.min.js' | asset_url }}" defer></script>{% endif %}

<script type="text/javascript">
var _iub = _iub || [];
