{% section 'cart-template' %}

{%- if cart.item_count > 0 -%}
  {% section 'static-recently-viewed-products' %}
{%- endif -%}
{% if settings.mlvedaACS_isMessageDisplay %}
  <p class="mlvedaCartNote" style="display:none">
    {{
      settings.mlvedaACS_messageContent
      | replace: '<<shop.name>>', shop.name
      | replace: '<<shop.currency>>', shop.currency
      | replace: '<<shop.selected_currency>>', "<span class='selected-currency'></span>"
    }}
  </p>
{% endif %}

<script src="https://widget.sezzle.com/v1/javascript/price-widget?uuid=0f9104b1-f9c7-42e0-bf8e-e7359cf1d86e"></script>
